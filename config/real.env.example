# Optional real-mode configuration for the Micro850 conveyor.
# Copy to .env and export the variables you need. .env is gitignored.
# Leave MODE=simulation to keep the simulated Modbus server and tests unchanged.
MODE=simulation
REAL_STRICT=true
LOG_LEVEL=INFO

# Writes are disabled by default; the adapter is read-only.
ALLOW_WRITES=false

# Required when MODE=real (replace placeholders with real plant values).
MODBUS_HOST=<PLC_IP_ADDRESS>
MODBUS_PORT=<MODBUS_TCP_PORT>
MODBUS_UNIT_ID=<UNIT_ID>

# Optional partial overrides of the documented register/coil maps (JSON).
# MODBUS_REGISTER_MAP={"State":0,"Parts_Total":1,"Belt_Speed_pct":6}
# MODBUS_COIL_MAP={"Conveyor_Run":0,"Auto_Mode":4}
